# Copy this file to `.env` for local development: cp .env.example .env
# NEVER commit your real .env (it is already in .gitignore).
# On Render, do NOT upload this file — enter these values in the dashboard.

# ── Groq (AI) ──────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile   # optional; this is the default

# ── Supabase (auth + database) ─────────────────────────────
# Project settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Server ─────────────────────────────────────────────────
# PORT is provided automatically by Render; only set it locally if needed.
# PORT=8100
